<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.easyprofile" path="/org/gnome/shell/extensions/easyprofile/">
    <!-- Volume Steps (with autorepeat) on '+' and '-' -->
    <key name="shortcut-volume-up" type="as">
      <default><![CDATA[['KP_Add']]]></default>
      <summary>Volume +1% (Saída ou Microfone)</summary>
    </key>
    <key name="shortcut-volume-down" type="as">
      <default><![CDATA[['KP_Subtract']]]></default>
      <summary>Volume -1% (Saída ou Microfone)</summary>
    </key>

    <!-- Destination & Mic Selection (IGNORE_AUTOREPEAT) -->
    <key name="shortcut-dest-akg" type="as">
      <default><![CDATA[['KP_1']]]></default>
      <summary>Selecionar Fone AKG K52</summary>
    </key>
    <key name="shortcut-dest-sp166" type="as">
      <default><![CDATA[['KP_2']]]></default>
      <summary>Selecionar Caixas SP166</summary>
    </key>
    <key name="shortcut-select-mic" type="as">
      <default><![CDATA[['KP_3']]]></default>
      <summary>Selecionar Microfone para ajuste com +/-</summary>
    </key>

    <!-- Presets Navigation: 4 = Base, 5 = Previous, 6 = Next (IGNORE_AUTOREPEAT) -->
    <key name="shortcut-preset-1" type="as">
      <default><![CDATA[['KP_4']]]></default>
      <summary>Selecionar Preset Base do dispositivo ativo</summary>
    </key>
    <key name="shortcut-preset-2" type="as">
      <default><![CDATA[['KP_5']]]></default>
      <summary>Preset Anterior do dispositivo ativo</summary>
    </key>
    <key name="shortcut-preset-3" type="as">
      <default><![CDATA[['KP_6']]]></default>
      <summary>Próximo Preset do dispositivo ativo</summary>
    </key>

    <!-- Toggles & Mutes (IGNORE_AUTOREPEAT) -->
    <key name="shortcut-mute-mic" type="as">
      <default><![CDATA[['KP_0']]]></default>
      <summary>Toggle Dual-Mute Microfone</summary>
    </key>
    <key name="shortcut-mute-output" type="as">
      <default><![CDATA[['KP_Decimal', 'KP_Separator']]]></default>
      <summary>Toggle Mute Saída</summary>
    </key>
    <key name="shortcut-mute-panic" type="as">
      <default><![CDATA[['KP_Enter']]]></default>
      <summary>Toggle Mute Total (Pânico)</summary>
    </key>

    <!-- Daily reset on '*' and DynamicEqualizer placeholder on '/' -->
    <key name="shortcut-dynamic-eq" type="as">
      <default><![CDATA[['KP_Divide']]]></default>
      <summary>Ativar DynamicEqualizer</summary>
    </key>
    <key name="shortcut-reset-app" type="as">
      <default><![CDATA[['KP_Multiply']]]></default>
      <summary>Resetar Padrão Diário preservando mute do microfone</summary>
    </key>

    <!-- Key 7: Toggle Escuta do Microfone com Filtros -->
    <key name="shortcut-noop-7" type="as">
      <default><![CDATA[['KP_7']]]></default>
      <summary>Toggle Escuta do Microfone com Filtros</summary>
    </key>
    <key name="shortcut-noop-8" type="as">
      <default><![CDATA[['KP_8']]]></default>
      <summary>Alternar compartilhamento de toda a saída na chamada</summary>
    </key>
    <key name="shortcut-noop-9" type="as">
      <default><![CDATA[['KP_9']]]></default>
      <summary>Alternar Boost da saída até 112%</summary>
    </key>
  </schema>
</schemalist>
